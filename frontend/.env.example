# Frontend Environment Variables
# Copy this file to .env and fill in your values

# Backend API URL (required in production)
# Points to your deployed backend on Vercel
# Example: https://golf-charity-backend.vercel.app
VITE_API_URL=https://your-backend.vercel.app

# For local development, leave VITE_API_URL empty or omit it.
# The Vite dev server will proxy /api calls to localhost:5000 via vite.config.js.
