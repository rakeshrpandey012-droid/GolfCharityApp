{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend"
    }
  },
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    },
    {
      "version": 2,
      "rewrites": [
        {
          "source": "/api/(.*)",
          "destination": "/backend/index.js"
        },
        {
          "source": "/(.*)",
          "destination": "/frontend/$1"
        },
        {
          "version": 2,
          "builds": [
            {
              "src": "backend/index.js",
              "use": "@vercel/node"
            }
          ],
          "routes": [
            {
              "src": "/(.*)",
              "destination": "backend/index.js"
            }
          ]
        }
      ]
    }
  ]
}
